                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "40ab4ab1-3fe0-463d-931d-d02f05279db8",
                    "leftValue": "={{ $json.lane }}",
                    "rightValue": "quick-qa",
                    "operator": {
                      "type": "string",
                      "operation": "equals",
                      "name": "filter.operator.string.equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "quick-qa"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameOnMatch": true
        }
      },
