                },
                "conditions": [
                  {
                    "id": "4aaa2a52-854c-4522-94d4-68e778d3d202",
                    "leftValue": "={{ $json.lane }}",
                    "rightValue": "research",
                    "operator": {
                      "type": "string",
                      "operation": "equals",
                      "name": "filter.operator.string.equals"
                    }
