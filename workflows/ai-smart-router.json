      },
      "id": "2c2f1181-b2dc-4691-a8ab-acb9b8260337",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "c0414f36-cc54-4b23-a4e1-bfd8df66a36e"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $input.first().json.body || $input.first().json;\nreturn [{ json: { task: (b.task || 'quick-qa').toLowerCase(), text: b.text || '' } }];"
      },
      "id": "ba8b1d35-5058-4151-880a-c2af00d91fc5",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.OPENROUTER_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "HTTP-Referer",
              "value": "https://github.com/maticcretic-commits/n8n-ai-router"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\"model\": \"deepseek/deepseek-chat-v3-0324:free\", \"messages\": [{\"role\": \"system\", \"content\": \"You are an intent classifier. Reply with ONLY valid JSON like {\\\"lane\\\": \\\"code\\\"}. Lanes: code (programming, debugging, scripts), writing (emails, blogs, copy), research (analysis, comparisons, deep questions), quick-qa (everything else).\"}, {\"role\": \"user\", \"content\": $json.text}]}) }}",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "3baf72bf-b161-4ab9-86e3-8ba9e044c4ba",
      "name": "Classify Intent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "notes": "Free classifier. Swap the model id any time at openrouter.ai/models."
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = $input.first().json.choices?.[0]?.message?.content || '{}';\nconst prev = $('Normalize Input').first().json;\nlet lane = 'quick-qa';\ntry { const m = raw.match(/\\{[\\s\\S]*\\}/); if (m) lane = (JSON.parse(m[0]).lane || lane).toLowerCase(); } catch (e) {}\nif (!['code','writing','research','quick-qa'].includes(lane)) lane = 'quick-qa';\nreturn [{ json: { lane, task: prev.task, text: prev.text } }];"
      },
      "id": "80738b34-9fb0-4378-9bf0-aae04c782212",
      "name": "Parse Lane",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "fc81e042-f274-4878-913a-f10a6c1d6976",
                    "leftValue": "={{ $json.lane }}",
                    "rightValue": "code",
                    "operator": {
                      "type": "string",
                      "operation": "equals",
                      "name": "filter.operator.string.equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "code"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "d509c405-6825-49ac-8af5-70f8def4ff89",
                    "leftValue": "={{ $json.lane }}",
                    "rightValue": "writing",
                    "operator": {
                      "type": "string",
                      "operation": "equals",
                      "name": "filter.operator.string.equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "writing"
            },
            {
              "conditions": {
                "options": {
